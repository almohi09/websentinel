# Copy to .env and fill in real values. Never commit .env.

# Database
DB_URL=jdbc:postgresql://localhost:5432/websentinel_dev
DB_USERNAME=websentinel
DB_PASSWORD=websentinel

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change-me-in-production-use-256-bit-random
JWT_EXPIRATION_MS=86400000

# Mail
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# CORS
CORS_ORIGINS=http://localhost:3000

# Server
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev